# ۴ دیواری — environment template
# Never commit real secrets. Production must fail closed without these values.
KHB_ENV=development
KHB_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
KHB_JWT_TTL=86400
KHB_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
KHB_DATA_DIR=./backend/data
KHB_UPLOAD_DIR=./backend/uploads
KHB_MAX_UPLOAD_BYTES=10485760
# Development/test only. Leave empty in production.
KHB_DEV_OTP=123456

# Optional future integrations
KHB_API_BASE=http://localhost:8000
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NUMBER=
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=
MAP_PROVIDER=
MAP_API_KEY=
KATEB_INTEGRATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=
